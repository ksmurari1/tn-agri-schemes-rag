OPENAI_API_KEY=replace_with_your_key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODERATION_MODEL=omni-moderation-latest
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: voice questions (speech-to-text). Defaults are used when these are not set.
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_TRANSCRIBE_LANGUAGE=        # e.g. ta for Tamil, en for English; leave empty to auto-detect
# OPENAI_TRANSCRIBE_PROMPT=          # optional spelling hints, e.g. scheme names
